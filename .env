# App Config
PROJECT_NAME="Prain Backend"
API_V1_STR="/api/v1"
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_CHANGE_THIS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Token Encryption Key (Fernet Key)
# 터미널에서 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 로 생성
TOKEN_ENCRYPTION_KEY="GENERATE_AND_PASTE_KEY_HERE"

# Database (PostgreSQL 비동기 접속 주소 / 로컬 테스트용 SQLite 설정 가능)
DATABASE_URL="sqlite+aiosqlite:///./prain.db"

